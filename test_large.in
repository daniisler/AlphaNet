# ------------------------
# 1. 初始化设置
# ------------------------
units       metal
atom_style  atomic
newton      on

# ------------------------
# 2. 建立系统结构
# ------------------------
boundary    p p p
lattice     fcc 4.06
# 3x3x3 超胞
region      simbox block 0 10 0 10 0 10
create_box  1 simbox
create_atoms 1 box
mass        1 26.98

# ------------------------
# 3. 设置 AlphaNet 力场
# ------------------------
pair_style  mliap unified alphanet_lammps.pt 0
pair_coeff  * * Al

# ------------------------
# 4. 阶段一：结构优化 (Relaxation)
# ------------------------
neighbor    4.0 bin
neigh_modify delay 0 every 1 check yes

thermo      10
thermo_style custom step temp pe press pxx pyy pzz lx ly lz vol

# 定义 minimize 阶段的 dump
dump        1 all custom 10 dump_min.lammpstrj id type x y z fx fy fz

# 弛豫盒子，目标压力为 0
fix         1 all box/relax iso 0.0 vmax 0.001
minimize    1.0e-6 1.0e-8 1000 10000

# [关键] 必须先取消 fix 和 dump
unfix       1
undump      1

# ------------------------
# 5. 阶段二：动力学模拟 (NVE)
# ------------------------
# 重置时间步
reset_timestep 0

timestep    0.001
thermo      100
# 输出晶胞参数 (lx, ly, lz) 方便观察盒子是否变大
thermo_style custom step temp pe ke etotal press vol lx ly lz

dump        2 all custom 100 dump_npt.lammpstrj id type x y z fx fy fz

velocity    all create 300.0 12345 dist gaussian

# [关键修改] 使用 NPT 系综
# temp 300 300 0.1   : 控温 300K (阻尼 0.1ps)
# iso 0.0 0.0 1.0    : 控压 0.0 bar (各向同性, 阻尼 1.0ps)
fix         2 all npt temp 300.0 300.0 0.1 iso 0.0 0.0 1.0

# 运行步数建议长一点，让体积有时间弛豫
run         5000