# ------------------------
# 1. 初始化设置
# ------------------------
units       metal
atom_style  atomic
newton      on
boundary    p p p

# ------------------------
# 2. 读取 ASE 生成的结构
# ------------------------
# ASE 输出的 data 文件会自动包含 mass 等信息
read_data   methane_ase.data
mass        1 12.011
mass        2 1.008
# ------------------------
# 3. 设置 AlphaNet 力场
# ------------------------
pair_style  mliap unified alphanet_lammps.pt 0
# ASE 的 specorder=['C', 'H'] 保证了 Type 1=C, Type 2=H
pair_coeff  * * C H

# ------------------------
# 4. 结构优化 (Minimize)
# ------------------------
neighbor    4.0 bin
neigh_modify delay 0 every 1 check yes

thermo      10
thermo_style custom step temp pe etotal press vol

dump        1 all custom 10 dump_min.lammpstrj id type x y z fx fy fz

# 由于 Python 里已经做过 coarse optimize，这里的 minimize 会非常快
minimize    1.0e-6 1.0e-8 1000 10000
undump      1

# ------------------------
# 5. 动力学模拟 (NVE)
# ------------------------
reset_timestep 0
timestep    0.0005 

thermo      100
thermo_style custom step temp pe ke etotal press

dump        2 all custom 50 dump_nve.lammpstrj id type x y z fx fy fz

# 300K 初始化
velocity    all create 200.0 48279 dist gaussian mom yes rot yes

fix         1 all nve

# 运行 5000 步
run         5000